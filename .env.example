# MongoDB connection string. The path selects the database (defaults to TagDB).
MONGODB_URI=

# Discord OAuth application used for sign-in.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord bot token used to look up tag owners' names and avatars.
DISCORD_BOT_TOKEN=

# next-auth session signing secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Public URL of the site. Required in production for OAuth redirects.
NEXTAUTH_URL=http://localhost:3000
